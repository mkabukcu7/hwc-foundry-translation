# SPDX-License-Identifier: MIT
# Azure translation and extraction
TRANSLATOR_ENDPOINT=<translator-resource-origin>
DOCINTEL_ENDPOINT=<document-intelligence-origin>

# Phase 1 list — replace with the marketing team's confirmed list
SUPPORTED_LANGUAGES=en,fr,de,es,it,pt,pt-PT,nl,pl,sv,da,nb,fi

# Optional model deployment
FOUNDRY_MODEL_ENDPOINT=
TRANSLATION_MODEL_NAME=
TRANSLATION_REASONING_EFFORT=low

# Estimated USD per million units; blank means unknown
TRANSLATOR_CHARACTER_RATE=
LLM_INPUT_RATE=
LLM_OUTPUT_RATE=

# Glossary
GLOSSARY_PATH=
GLOSSARY_MODE=static

# API, storage and optional file source
STORAGE_BLOB_ENDPOINT=<blob-service-origin>
STORAGE_TABLE_ENDPOINT=<table-service-origin>
API_CLIENT_ID=<api-application-id>
API_ALLOWED_AUDIENCE=api://<api-application-id>
SHAREPOINT_HOSTS=

# Optional slide renderer
SLIDE_RENDER_URL=
SLIDE_RENDER_SCOPE=

# Document size limits in MiB
MAX_BASE64_MB=10
MAX_MULTIPART_MB=40
MAX_DOCUMENT_MB=40

# Local dev
PYTHON_EXECUTABLE=<path-to-python-3.11>
